{
  "info": {
    "name": "Sabor Gourmet - EVA2 - Pruebas REST",
    "description": "Colección de pruebas funcionales y errores para la Unidad 2. Importar en Postman. Ejecutar primero la carpeta 01 en orden y solo luego de reiniciar manualmente la carpeta 02. Genera registros de prueba en datos.json.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "clienteId",
      "value": "",
      "type": "string"
    },
    {
      "key": "clienteTemporalId",
      "value": "",
      "type": "string"
    },
    {
      "key": "mesaId",
      "value": "",
      "type": "string"
    },
    {
      "key": "mesaLibreId",
      "value": "",
      "type": "string"
    },
    {
      "key": "reservaId",
      "value": "",
      "type": "string"
    },
    {
      "key": "correoUnico",
      "value": "",
      "type": "string"
    },
    {
      "key": "numeroMesa",
      "value": "",
      "type": "string"
    },
    {
      "key": "numeroMesaLibre",
      "value": "",
      "type": "string"
    },
    {
      "key": "fechaPrueba",
      "value": "2031-05-14",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Pruebas funcionales, HTTP y errores",
      "description": "Ejecutar secuencialmente usando Run collection con la API activa. La primera solicitud genera datos unicos. Son 39 escenarios que dejan una reserva cancelada en datos.json.",
      "item": [
        {
          "name": "01 - GET listar clientes",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/clientes",
            "description": ""
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Datos unicos para poder repetir las pruebas sin duplicar emails ni mesas.",
                  "const n = Date.now();",
                  "pm.collectionVariables.set(\"correoUnico\", \"eva2.\" + n + \"@ejemplo.cl\");",
                  "const base = Math.floor(1000000 + Math.random() * 900000000);",
                  "pm.collectionVariables.set(\"numeroMesa\", String(base));",
                  "pm.collectionVariables.set(\"numeroMesaLibre\", String(base + 1));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Responde un arreglo JSON\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "02 - POST crear cliente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/clientes",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Daniela\",\n  \"apellido\": \"Reyes\",\n  \"email\": \"{{correoUnico}}\",\n  \"telefono\": \"+56911112222\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "const j=pm.response.json();",
                  "pm.test(\"Cliente creado con ID\", () => pm.expect(j.id).to.be.a(\"number\"));",
                  "pm.collectionVariables.set(\"clienteId\",String(j.id));",
                  "pm.test(\"Email guardado\", () => pm.expect(j.email).to.eql(pm.collectionVariables.get(\"correoUnico\").toLowerCase()));"
                ]
              }
            }
          ]
        },
